Options -MultiViews
DirectoryIndex index.html
RewriteEngine On

# ✅ Block Next internal txt files everywhere
RedirectMatch 404 (^|/)(__next.*\.txt)$

# ✅ Enable compression for JS/CSS chunks
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/javascript text/css application/json
</IfModule>

# ✅ Serve pre-compressed .js.gz files if they exist
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP:Accept-Encoding} gzip
  RewriteCond %{REQUEST_FILENAME}.gz -f
  RewriteRule ^(.*)$ $1.gz [QSA,L]
</IfModule>

# ✅ Long cache for _next static assets (they have hash in filename — safe to cache forever)
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff|woff2|ttf|png|jpg|jpeg|gif|svg|ico|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ✅ Allow _next static assets (IMPORTANT)
RewriteRule ^_next/ - [L]

# ✅ Allow static files (images, js, css, fonts)
RewriteCond %{REQUEST_URI} \.(js|css|png|jpg|jpeg|gif|svg|ico|webp|woff|woff2|ttf)$ [NC]
RewriteRule ^ - [L]

# ✅ Allow real files/folders
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ✅ Inventory deep routes
RewriteRule ^inventory(/.*)?$ /inventory/index.html [L]

# ✅ Checkout deep routes
RewriteRule ^checkout(/.*)?$ /checkout/index.html [L]

# ✅ Confirmation deep routes
RewriteRule ^confirmation(/.*)?$ /confirmation/index.html [L]

RewriteRule ^sale-agreement(/.*)?$ /sale-agreement/index.html [L]

# ✅ Admin panel deep routes
RewriteRule ^admin(/.*)?$ /admin/index.html [L]

# ✅ User panel deep routes
RewriteRule ^user(/.*)?$ /user/index.html [L]

# ✅ Verification status routes
RewriteRule ^verification-status(/.*)?$ /verification-status/index.html [L]

# ✅ Verify account routes
RewriteRule ^verify-account(/.*)?$ /verify-account/index.html [L]

# ✅ SPA fallback
RewriteRule . /index.html [L]