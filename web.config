<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <rewrite>
      <rules>

        <!-- Static files -->
        <rule name="StaticFiles" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAny">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
          </conditions>
          <action type="None" />
        </rule>

        <!-- Inventory -->
        <rule name="Inventory" stopProcessing="true">
          <match url="^inventory/.*" />
          <action type="Rewrite" url="/inventory/index.html" />
        </rule>

        <!-- Checkout -->
        <rule name="Checkout" stopProcessing="true">
          <match url="^checkout/.*" />
          <action type="Rewrite" url="/checkout/index.html" />
        </rule>

        <!-- Confirmation -->
        <rule name="Confirmation" stopProcessing="true">
          <match url="^confirmation/.*" />
          <action type="Rewrite" url="/confirmation/index.html" />
        </rule>

        <!-- Sale Agreement -->
        <rule name="SaleAgreement" stopProcessing="true">
          <match url="^sale-agreement/.*" />
          <action type="Rewrite" url="/sale-agreement/index.html" />
        </rule>

        <!-- Admin -->
        <rule name="Admin" stopProcessing="true">
          <match url="^admin/.*" />
          <action type="Rewrite" url="/admin/index.html" />
        </rule>

        <!-- User -->
        <rule name="User" stopProcessing="true">
          <match url="^user/.*" />
          <action type="Rewrite" url="/user/index.html" />
        </rule>

        <!-- Verification -->
        <rule name="VerificationStatus" stopProcessing="true">
          <match url="^verification-status/.*" />
          <action type="Rewrite" url="/verification-status/index.html" />
        </rule>

        <!-- Verify Account -->
        <rule name="VerifyAccount" stopProcessing="true">
          <match url="^verify-account/.*" />
          <action type="Rewrite" url="/verify-account/index.html" />
        </rule>

      </rules>
    </rewrite>

    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

  </system.webServer>
</configuration>