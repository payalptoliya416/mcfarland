<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- 1. Allow Next.js static asset bundles (_next folder) to load directly -->
        <rule name="NextStatic" stopProcessing="true">
          <match url="^_next/(.*)" />
          <action type="None" />
        </rule>

        <!-- 2. Allow existing static files or folders to pass through directly -->
        <rule name="StaticContent" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="None" />
        </rule>

        <!-- 3. Inventory deep routes to /inventory/index.html -->
        <rule name="InventoryRoutes" stopProcessing="true">
          <match url="^inventory(/.*)?$" />
          <action type="Rewrite" url="inventory/index.html" />
        </rule>

        <!-- 4. Checkout deep routes to /checkout/index.html -->
        <rule name="CheckoutRoutes" stopProcessing="true">
          <match url="^checkout(/.*)?$" />
          <action type="Rewrite" url="checkout/index.html" />
        </rule>

        <!-- 5. Confirmation deep routes to /confirmation/index.html -->
        <rule name="ConfirmationRoutes" stopProcessing="true">
          <match url="^confirmation(/.*)?$" />
          <action type="Rewrite" url="confirmation/index.html" />
        </rule>

        <!-- 6. Sale Agreement deep routes to /sale-agreement/index.html -->
        <rule name="SaleAgreementRoutes" stopProcessing="true">
          <match url="^sale-agreement(/.*)?$" />
          <action type="Rewrite" url="sale-agreement/index.html" />
        </rule>

        <!-- 7. Admin panel deep routes to /admin/index.html -->
        <rule name="AdminRoutes" stopProcessing="true">
          <match url="^admin(/.*)?$" />
          <action type="Rewrite" url="admin/index.html" />
        </rule>

        <!-- 8. User panel deep routes to /user/index.html -->
        <rule name="UserRoutes" stopProcessing="true">
          <match url="^user(/.*)?$" />
          <action type="Rewrite" url="user/index.html" />
        </rule>

        <!-- 9. Verification status routes to /verification-status/index.html -->
        <rule name="VerificationStatusRoutes" stopProcessing="true">
          <match url="^verification-status(/.*)?$" />
          <action type="Rewrite" url="verification-status/index.html" />
        </rule>

        <!-- 10. Verify account routes to /verify-account/index.html -->
        <rule name="VerifyAccountRoutes" stopProcessing="true">
          <match url="^verify-account(/.*)?$" />
          <action type="Rewrite" url="verify-account/index.html" />
        </rule>

        <!-- 11. General SPA Fallback for any other custom sub-routes -->
        <rule name="SPAFallback" stopProcessing="true">
          <match url="." />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.html" />
        </rule>
      </rules>
    </rewrite>
    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>
